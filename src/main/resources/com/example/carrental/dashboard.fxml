<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane fx:controller="com.example.carrental.controller.DashboardController" prefHeight="768.0" prefWidth="1280.0" style="-fx-background-color: #f5f2eb;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 15 25; -fx-background-color: #f5f2eb;">
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="CarviaRental" />

            <HBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #eae5dc; -fx-background-radius: 20; -fx-padding: 4;">
                <Button fx:id="navOverview" onAction="#handleShowOverview" text="🏠 Overview" />
                <Button fx:id="navVehicles" onAction="#handleShowVehicles" text="🚘 Vehicles" />
                <Button fx:id="navRentals" onAction="#handleShowRentals" text="📋 Rentals" />
            </HBox>

            <Pane HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="15.0">
                <Label style="-fx-text-fill: #555555;" text="📍 Bacolod City, Negros Occidental" />
                <Label fx:id="clockLabel" style="-fx-text-fill: #555555;" />
                <Circle radius="16.0" style="-fx-fill: #cccccc;" />
            </HBox>
        </HBox>
    </top>
    <center>
        <StackPane>
            <fx:include fx:id="overview" source="overview.fxml" />
            <fx:include fx:id="vehicles" source="vehicles.fxml" />
            <fx:include fx:id="rentals" source="rentals.fxml" />
        </StackPane>
    </center>
</BorderPane>
