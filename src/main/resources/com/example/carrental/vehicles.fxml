<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox maxHeight="Infinity" maxWidth="Infinity" spacing="20.0" style="-fx-background-color: #f5f2eb;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.carrental.controller.VehicleController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
    </padding>

    <VBox spacing="12.0" HBox.hgrow="ALWAYS">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="Manage Vehicles" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #777777;" text="Click a row to edit or delete it. Click a column header to sort." />
        <TableView fx:id="vehicleTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="Name" />
                <TableColumn fx:id="colBrand" text="Brand" />
                <TableColumn fx:id="colType" text="Type" />
                <TableColumn fx:id="colTransmission" text="Transmission" />
                <TableColumn fx:id="colRate" text="Rate / day" />
                <TableColumn fx:id="colStatus" text="Status" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <VBox minWidth="300.0" prefWidth="300.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Vehicle details" />

        <Label style="-fx-font-size: 12px; -fx-text-fill: #444;" text="Name" />
        <TextField fx:id="nameField" />
        <Label style="-fx-font-size: 12px; -fx-text-fill: #444;" text="Brand" />
        <TextField fx:id="brandField" />
        <Label style="-fx-font-size: 12px; -fx-text-fill: #444;" text="Type (can't change after adding)" />
        <ComboBox fx:id="typeBox" maxWidth="Infinity" />
        <Label style="-fx-font-size: 12px; -fx-text-fill: #444;" text="Transmission" />
        <ComboBox fx:id="transmissionBox" maxWidth="Infinity" />
        <Label style="-fx-font-size: 12px; -fx-text-fill: #444;" text="Daily rate (₱)" />
        <TextField fx:id="rateField" />
        <Label style="-fx-font-size: 12px; -fx-text-fill: #444;" text="Horsepower (optional)" />
        <TextField fx:id="hpField" promptText="e.g. 98 hp" />
        <Label style="-fx-font-size: 12px; -fx-text-fill: #444;" text="Fuel economy (optional)" />
        <TextField fx:id="fuelField" promptText="e.g. 17 km/L" />

        <HBox spacing="8.0">
            <Button onAction="#handleAdd" style="-fx-background-color: #111111; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Add" />
            <Button onAction="#handleUpdate" style="-fx-background-color: #111111; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Update" />
            <Button onAction="#handleDelete" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Delete" />
            <Button onAction="#handleClear" style="-fx-background-color: #eee; -fx-background-radius: 10; -fx-cursor: hand;" text="Clear" />
        </HBox>
    </VBox>
</HBox>
