<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" maxHeight="Infinity" maxWidth="Infinity" style="-fx-background: #f5f2eb; -fx-background-color: #f5f2eb; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.carrental.controller.OverviewController">
    <VBox prefHeight="362.0" prefWidth="1410.0" spacing="20.0">
        <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <VBox spacing="3.0">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="Available Cars" />
                <Label fx:id="subtitleLabel" style="-fx-font-size: 13px; -fx-text-fill: #777777;" />
            </VBox>

            <Pane HBox.hgrow="ALWAYS" />

            <TextField fx:id="searchField" prefWidth="210.0" promptText="🔍 Search name, brand, type" style="-fx-background-radius: 12; -fx-padding: 10 14;" />
            <ComboBox fx:id="sortBox" prefWidth="165.0" />

            <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12 20;">
                <Label style="-fx-font-size: 16px;" text="🚗" />
                <VBox>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Available Cars" />
                    <Label fx:id="availableCountLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                </VBox>
            </HBox>
            <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12 20;">
                <Label style="-fx-font-size: 16px;" text="⭐" />
                <VBox>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Average Rating" />
                    <Label fx:id="avgRatingLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                </VBox>
            </HBox>
            <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12 20;">
                <Label style="-fx-font-size: 16px;" text="📋" />
                <VBox>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Active Rentals" />
                    <Label fx:id="activeRentalsLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                </VBox>
            </HBox>
        </HBox>

        <HBox spacing="20.0">

            <!-- FILTERS -->
            <VBox minWidth="240.0" prefWidth="240.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;">
                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Filter by" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Hyperlink onAction="#handleResetFilters" style="-fx-text-fill: #888888; -fx-font-size: 12px;" text="Reset all" />
                </HBox>

                <VBox spacing="8.0">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #444;" text="Rental Type" />
                    <HBox spacing="5.0">
                        <Button fx:id="dailyBtn" onAction="#handleDaily" text="Daily" />
                        <Button fx:id="weeklyBtn" onAction="#handleWeekly" text="Weekly" />
                        <Button fx:id="monthlyBtn" onAction="#handleMonthly" text="Monthly" />
                    </HBox>
                </VBox>

                <Separator />

                <VBox spacing="8.0">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #444;" text="Brand" />
                    <FlowPane fx:id="brandFilters" hgap="12.0" vgap="8.0" />
                </VBox>

                <Separator />

                <VBox spacing="8.0">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #444;" text="Vehicle Type" />
                    <FlowPane fx:id="typeFilters" hgap="12.0" vgap="8.0" />
                </VBox>
            </VBox>

            <!-- CAR CARDS (filled in by OverviewController) -->
            <FlowPane fx:id="carGrid" hgap="15.0" prefWrapLength="640.0" vgap="15.0" HBox.hgrow="ALWAYS" />

            <!-- DETAILS PANEL -->
            <VBox minWidth="280.0" prefHeight="246.0" prefWidth="314.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;">
                <Label fx:id="detailPlaceholder" style="-fx-text-fill: #888888;" text="Select a car to see its details." wrapText="true" />

                <VBox fx:id="detailContent" managed="false" spacing="12.0" visible="false">
                    <HBox alignment="CENTER_LEFT">
                        <Button onAction="#handleClearSelection" style="-fx-background-color: #eee; -fx-background-radius: 20; -fx-cursor: hand;" text="✕" />
                    </HBox>

                    <StackPane prefHeight="150.0" style="-fx-background-color: #f5f2eb; -fx-background-radius: 12;">
                        <ImageView fx:id="detailImage" fitHeight="140.0" fitWidth="240.0" preserveRatio="true" />
                        <Label fx:id="detailEmoji" style="-fx-font-size: 64px;" />
                    </StackPane>

                    <Label fx:id="detailName" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111111;" wrapText="true" />
                    <HBox alignment="BASELINE_LEFT" spacing="8.0">
                        <Label fx:id="detailPrice" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111111;" />
                        <Label fx:id="detailPriceUnit" opacity="0.61" />
                    </HBox>
                    <Label fx:id="detailSub" style="-fx-font-size: 12px; -fx-text-fill: #888888;" />

                    <Label fx:id="toggleLabel1" onMouseClicked="#handleToggleSpecs" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555555; -fx-cursor: hand;" text="▼ Show Specifications" />
                    <VBox fx:id="specsBox" managed="false" spacing="5.0" visible="false">
                        <Label fx:id="specBrand" style="-fx-font-size: 12px; -fx-text-fill: #555555;" />
                        <Label fx:id="specPower" style="-fx-font-size: 12px; -fx-text-fill: #555555;" />
                        <Label fx:id="specFuel" style="-fx-font-size: 12px; -fx-text-fill: #555555;" />
                        <Label fx:id="specSeats" style="-fx-font-size: 12px; -fx-text-fill: #555555;" />
                        <Label fx:id="specBase" style="-fx-font-size: 12px; -fx-text-fill: #555555;" />
                        <Label fx:id="specInsurance" style="-fx-font-size: 12px; -fx-text-fill: #555555;" />
                    </VBox>

                    <Button fx:id="rentButton" onAction="#handleRentNow" style="-fx-background-color: #111111; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 20; -fx-cursor: hand;" text="Rent Now" />
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
