<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="Infinity" maxWidth="Infinity" spacing="12.0" style="-fx-background-color: #f5f2eb;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.carrental.controller.RentalController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <VBox spacing="3.0">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="Rentals" />
            <Label fx:id="summaryLabel" style="-fx-font-size: 13px; -fx-text-fill: #777777;" />
        </VBox>
        <Pane HBox.hgrow="ALWAYS" />
        <Button onAction="#handleUpdate" style="-fx-background-color: #111111; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Edit rental" />
        <Button onAction="#handleReturn" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Return car" />
        <Button onAction="#handleDelete" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Delete" />
    </HBox>

    <TableView fx:id="rentalTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" maxWidth="60.0" text="#" />
            <TableColumn fx:id="colCustomer" text="Customer" />
            <TableColumn fx:id="colContact" text="Contact" />
            <TableColumn fx:id="colVehicle" text="Vehicle" />
            <TableColumn fx:id="colPlan" text="Plan" />
            <TableColumn fx:id="colStart" text="Start" />
            <TableColumn fx:id="colEnd" text="Return by" />
            <TableColumn fx:id="colDuration" text="Duration" />
            <TableColumn fx:id="colTotal" text="Total" />
            <TableColumn fx:id="colStatus" text="Status" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
